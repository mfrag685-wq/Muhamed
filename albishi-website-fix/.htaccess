# إعدادات Apache لموقع البيشي. ضعه في جذر الموقع (بجانب index.html).
# يتطلب تفعيل mod_rewrite و mod_headers و mod_deflate و mod_expires في httpd.conf

Options -Indexes
ServerSignature Off

# ---- تحويل http إلى https ثم توحيد www ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://www.albishi.com.sa%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^albishi\.com\.sa$ [NC]
  RewriteRule ^ https://www.albishi.com.sa%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- ترويسات الأمان ----
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header unset X-Powered-By
</IfModule>

# ---- ضغط الملفات النصية ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/xml
</IfModule>

# ---- التخزين المؤقت ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# أنواع الملفات
AddType image/webp .webp
AddType video/mp4 .mp4
AddType text/javascript .js

# منع الوصول لملفات الإعداد والسكربتات
<FilesMatch "(^\.|\.(sh|bat|md|config\.js|input\.css)$)">
  Require all denied
</FilesMatch>
