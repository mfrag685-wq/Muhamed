# يمنع بقاء نسخة قديمة في متصفحات المستخدمين — يفرض إعادة التحقق من الخادم في كل مرة
# (يسمح بردّ 304 إن لم يتغيّر الملف، فلا يستهلك باقة Netlify)
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

/manifest.inventory.json
  Cache-Control: no-cache
