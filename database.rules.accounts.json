{
  "rules": {
    "workspaces": {
      "$wid": {
        "members": {
          ".read": "auth != null && ( root.child('workspaces').child($wid).child('members').child(auth.uid).child('role').val() === 'admin' || ( $wid === 'learn' && root.child('workspaces').child('main').child('members').child(auth.uid).child('role').val() === 'admin' ) )",
          "$uid": {
            ".read": "auth != null && ( auth.uid === $uid || root.child('workspaces').child($wid).child('members').child(auth.uid).child('role').val() === 'admin' || ( $wid === 'learn' && root.child('workspaces').child('main').child('members').child(auth.uid).child('role').val() === 'admin' ) )",
            ".write": "auth != null && ( ( auth.uid === $uid && !data.parent().exists() && $wid !== 'learn' ) || root.child('workspaces').child($wid).child('members').child(auth.uid).child('role').val() === 'admin' || ( $wid === 'learn' && root.child('workspaces').child('main').child('members').child(auth.uid).child('role').val() === 'admin' ) )"
          }
        },
        "requests": {
          ".read": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).child('role').val() === 'admin'",
          "$uid": {
            ".write": "auth != null && ( ( auth.uid === $uid && newData.exists() && newData.child('username').exists() ) || root.child('workspaces').child($wid).child('members').child(auth.uid).child('role').val() === 'admin' )"
          }
        },
        "root": {
          ".read": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()"
        },
        "platform": {
          ".read": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()"
        },
        "formatter": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()",
            ".write": "auth != null && auth.uid === $uid && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()"
          }
        },
        "devices": {
          ".read": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()"
        },
        "reloadReqs": {
          ".read": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()",
          ".write": "auth != null && root.child('workspaces').child($wid).child('members').child(auth.uid).exists()"
        }
      }
    }
  }
}
