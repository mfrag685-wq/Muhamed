{
  // إعداد Cloudflare — ملفات ثابتة + وسيط صغير لدفترة (worker.js)
  // كل الصفحات تُخدم كما هي؛ فقط المسار /daftra-proxy/* يمرّ عبر worker.js
  // (يتجاوز حجب CORS في «اختبار الاتصال» بنظام_دفترة_الذكي.html)
  "name": "muhamed",
  "compatibility_date": "2026-08-14",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/daftra-proxy/*"]
  }
}
